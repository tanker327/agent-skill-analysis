{
  "name": "agent-skill-analysis",
  "version": "0.1.0",
  "description": "Parse and analyze Claude Code / AI agent skills (SKILL.md) for quality, structure, and triggering effectiveness",
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "skills",
    "skill",
    "analysis",
    "lint",
    "ai"
  ],
  "license": "MIT",
  "author": "Eric Wu <tanker327@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanker327/skill-analysis.git"
  },
  "bugs": {
    "url": "https://github.com/tanker327/skill-analysis/issues"
  },
  "homepage": "https://github.com/tanker327/skill-analysis#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
