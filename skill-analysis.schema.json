{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "analyzerVersion": {
      "type": "string"
    },
    "specVersion": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "dir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "frontmatter": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "compatibility": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowedTools": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "extra": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "name",
        "description",
        "version",
        "license",
        "compatibility",
        "allowedTools",
        "metadata",
        "extra"
      ],
      "additionalProperties": false
    },
    "body": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "lines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "headings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "depth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "depth",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "text",
            "lines",
            "headings"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "readme": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "license": {
      "type": "object",
      "properties": {
        "declared": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "spdx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "frontmatter",
                "file"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "declared",
        "spdx",
        "file",
        "source"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "instructions",
              "reference",
              "asset",
              "script",
              "readme",
              "license",
              "other"
            ]
          },
          "isText": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "size",
          "sha256",
          "kind",
          "isText"
        ],
        "additionalProperties": false
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "body": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokenizer": {
          "type": "string"
        }
      },
      "required": [
        "metadata",
        "body",
        "total",
        "tokenizer"
      ],
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "properties": {
        "declared": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "broken": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orphans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "declared",
        "resolved",
        "broken",
        "orphans"
      ],
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byKind": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "instructions",
              "reference",
              "asset",
              "script",
              "readme",
              "license",
              "other"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "total",
        "byKind"
      ],
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "analyzerVersion",
    "specVersion",
    "ok",
    "dir",
    "frontmatter",
    "body",
    "readme",
    "license",
    "files",
    "tokens",
    "references",
    "size",
    "digest",
    "diagnostics"
  ],
  "additionalProperties": false
}
